{
  "headers": [
    {
      "source": "/regulations/(.*\\.pdf)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/v2",
      "destination": "/v2/",
      "permanent": true
    }
  ]
}
